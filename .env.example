# ==============================================================================
# CAPSIC CARE OS — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - NEVER commit real credentials, production database URLs, or API keys.
# - Use a separate isolated Supabase project for local development.
# ==============================================================================

# Application Runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration (DEVELOPMENT ENVIRONMENT ONLY)
# ------------------------------------------------------------------------------
# Create a dedicated free development project at https://supabase.com
# DO NOT paste live production credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key_here

# ------------------------------------------------------------------------------
# Communication & Notification Gateways
# ------------------------------------------------------------------------------
# WhatsApp Support / Booking Dispatcher
NEXT_PUBLIC_WHATSAPP_NUMBER=918910260709
WHATSAPP_API_ENDPOINT=https://graph.facebook.com/v19.0/your_phone_id/messages
WHATSAPP_API_TOKEN=your_dev_mock_token

# SMS Gateway (Optional in Dev / Synthetic by default)
SMS_GATEWAY_API_KEY=mock_dev_key

# ------------------------------------------------------------------------------
# Payment Integration (Synthetic / Test Mode)
# ------------------------------------------------------------------------------
# Use mock mode for local development. Do not enable live UPI/payment.
NEXT_PUBLIC_ENABLE_PAYMENT_GATEWAY=false
RAZORPAY_KEY_ID=rzp_test_mockKeyId
RAZORPAY_KEY_SECRET=mockSecretKey

# ------------------------------------------------------------------------------
# Analytics & Monitoring (Optional for Local Development)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
